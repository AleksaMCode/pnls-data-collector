# Test if WLAN1 is available first, only use WLAN0 as backup
INTERFACES = ["wlan1", "wlan0"]

TIMESTAMP_FORMAT = "%Y-%m-%d %H:%M:%S.%f"

SSID_FILTER = []

FIREBASE_CREDENTIALS = "firebase_credentials.json"

FIREBASE_DB_URL = "firebase_db_url"

# Name your RPI NODE in FireBase DB
FIREBASE_NODE = "RPI-1"

# Send status update every 10 minutes
FIREBASE_TIMEOUT_STATUS = 60 * 10
